cuda-python==13.0.3
# Keep the CUDA 13 CuPy provider explicit. vLLM is installed with --no-deps so
# Ray's cgraph metadata cannot add the mutually exclusive CUDA 12 provider.
cupy-cuda13x==14.2.0
kvikio-cu13==25.10.0

# CUTLASS backend for torch.compile (includes Python API and C++ headers).
# Use the [cu13] extra and exactly 4.5.2. This is the version validated for the
# Blackwell B200 and GB300 setup. It adds the Blackwell Ultra arches
# (sm_103/sm_103a/sm_103f) to the CuTe-DSL Arch enum, and the [cu13] extra pulls
# the CUDA-13 backend libs. 4.3.0 (base-only) lacks sm_103a, so the Python
# CuTe-DSL JIT labs (e.g. labs/block_scaling) cannot target GB300/sm_103.
nvidia-cutlass-dsl[cu13]==4.5.2

