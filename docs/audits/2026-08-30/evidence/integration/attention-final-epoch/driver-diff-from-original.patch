+def inspect_epoch(root: Path, manifest: list[dict]) -> tuple[list[dict], list[str]]:
+    """Verify real files; missing, duplicate, unsafe or changed paths reject."""
+    if not isinstance(manifest, list) or not manifest:
+        raise ValueError("A nonempty source manifest is required")
+    observed, mismatches, seen = [], [], set()
+    for item in manifest:
+        path, expected = item["path"], item["sha256"]
+        relative = Path(path)
+        if relative.is_absolute() or ".." in relative.parts or path in seen:
+            raise ValueError(f"Unsafe or duplicate manifest path: {path}")
+        if not re.fullmatch(r"[0-9a-f]{64}", expected):
+            raise ValueError(f"Invalid SHA256 for {path}")
+        seen.add(path)
+        target = root / relative
+        if not target.resolve().is_relative_to(root.resolve()):
+            raise ValueError(f"Manifest symlink escapes repository: {path}")
+        actual = hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else None
+        observed.append({"path": path, "sha256": actual})
+        if actual != expected:
+            mismatches.append(path)
+    return observed, mismatches
+
+
+def read_cases(path: Path) -> list[str]:
+    data = json.loads(path.read_text())
+    ids = data["nodeids"]
+    if data["counts"] != EXPECTED_COUNTS or len(ids) != 32 or len(set(ids)) != 32:
+        raise ValueError("Acceptance requires the reviewed 25+7 distinct cases")
+    for filename, count in [("test_audit_wave1_attention_regressions.py", 25),
+                            ("test_audit_wave1_prefill_full_output.py", 7)]:
+        prefix = "tests/" + filename + "::test_real_"
+        if sum(node.startswith(prefix) for node in ids) != count:
+            raise ValueError(f"Wrong case selection for {filename}")
+    return ids
+
+
+def assess_junit(path: Path, returncode: int, expected: list[str]) -> dict:
+    """Report parser only: fixtures testing this function are not GPU evidence."""
+    try:
+        root = ET.parse(path).getroot()
+        suites = list(root.iter("testsuite"))
+        counts = {key: sum(int(suite.get(key, "0")) for suite in suites)
+                  for key in ("tests", "failures", "errors", "skipped")}
+        cases = list(root.iter("testcase"))
+        observed = Counter((case.get("classname"), case.get("name")) for case in cases)
+        wanted = Counter((node.split("::", 1)[0][:-3].replace("/", "."), node.split("::", 1)[1])
+                         for node in expected)
+        unacceptable = any(case.find(tag) is not None for case in cases
+                           for tag in ("failure", "error", "skipped"))
+        accepted = (returncode == 0 and counts["tests"] == len(expected)
+                    and not any(counts[key] for key in ("failures", "errors", "skipped"))
+                    and observed == wanted and not unacceptable)
+        return {"accepted": accepted, "counts": counts,
+                "exact_case_identities": observed == wanted}
+    except (OSError, ET.ParseError, TypeError, ValueError) as error:
+        return {"accepted": False, "reason": f"Missing or invalid JUnit report: {error}"}
