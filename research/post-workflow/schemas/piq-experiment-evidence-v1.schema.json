{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piq:experiment-evidence:v1",
  "title": "PIQ diagnostic experiment evidence v1",
  "description": "Common diagnostic envelope. Qualification is unsupported by v1; hashes, retained file contents and identity bindings are checked by tools/piq_experiment_evidence.py.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "scope",
    "workload_family",
    "experiment",
    "stack",
    "objective",
    "attempts",
    "comparison",
    "correctness",
    "workload_evidence",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "piq_experiment_evidence"
    },
    "scope": {
      "const": "diagnostic"
    },
    "workload_family": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "question",
        "hypothesis",
        "workload_scope",
        "design",
        "source_artifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "workload_scope": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "$ref": "#/$defs/artifact"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": [
        "piq_revision",
        "runtime_identifier",
        "hardware_identifier",
        "layers"
      ],
      "properties": {
        "piq_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "runtime_identifier": {
          "type": "string",
          "minLength": 1
        },
        "hardware_identifier": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "identifier"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "identifier": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "metric",
        "unit",
        "direction",
        "window"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        },
        "window": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "run_id",
          "role",
          "status",
          "accepted",
          "raw_result",
          "failure_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "raw_result": {
            "$ref": "#/$defs/artifact"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "baseline_attempt_ids",
        "candidate_attempt_ids",
        "scientific_disposition",
        "reason"
      ],
      "properties": {
        "baseline_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scientific_disposition": {
          "enum": [
            "DIAGNOSTIC_ONLY",
            "INCONCLUSIVE",
            "REJECTED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correctness": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "workload_evidence": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Complete retained artifact index selected for import. Common contract references are a required subset with exact matching hashes. Additional declared native/API/custody evidence is allowed and receives the same path, byte-hash and no-symlink validation."
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Safe POSIX bundle-relative path; no symlinks or traversal."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workload_family": {
            "const": "cpu_data_query"
          }
        }
      },
      "then": {
        "properties": {
          "workload_evidence": {
            "required": [
              "query_plan"
            ]
          }
        }
      }
    }
  ]
}
