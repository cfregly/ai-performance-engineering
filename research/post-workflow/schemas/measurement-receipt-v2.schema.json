{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-drafts:measurement-receipt:v2",
  "title": "Qualified prospective CPU codec measurement receipt v2",
  "description": "Separate CPU contract. tools/qualified_cpu_study.py validates retained bytes, native PIQ identities, advance design and fixed scientific arithmetic. It does not amend GPU receipt v1 or PIQ diagnostic v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "execution_class", "workload_scope", "runtime_identifier", "hardware_identifier", "design", "registration", "raw_census", "correctness", "qualification_report", "baseline_review", "scientific_review", "source_artifacts", "piq_envelopes", "accepted_repeats", "failed_attempts", "profile_evidence", "claims"],
  "properties": {
    "schema_version": {"const": 2},
    "state": {"const": "measured"},
    "execution_class": {"const": "cpu"},
    "workload_scope": {"type": "string", "minLength": 1},
    "runtime_identifier": {"type": "string", "minLength": 1},
    "hardware_identifier": {"type": "string", "minLength": 1},
    "design": {"$ref": "#/$defs/artifact"},
    "registration": {"$ref": "#/$defs/artifact"},
    "raw_census": {"$ref": "#/$defs/artifact"},
    "correctness": {"$ref": "#/$defs/artifact"},
    "qualification_report": {"$ref": "#/$defs/artifact"},
    "baseline_review": {"$ref": "#/$defs/artifact"},
    "scientific_review": {"$ref": "#/$defs/artifact"},
    "source_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "piq_envelopes": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "accepted_repeats": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "accepted", "raw_result"], "properties": {
        "id": {"type": "string", "pattern": "^pair-0[1-4]$"},
        "accepted": {"const": true},
        "raw_result": {"$ref": "#/$defs/artifact"}
      }}
    },
    "failed_attempts": {
      "type": "array", "maxItems": 0,
      "description": "All failures remain in the raw census and an incomplete receipt; any failure makes this qualified receipt invalid. Do not remove failures to satisfy this field."
    },
    "profile_evidence": {
      "type": "array",
      "description": "An empty list is valid for explicitly unprofiled claims. CPU profiler claims require real retained captures; timing metadata is not a profile.",
      "items": {"type": "object", "additionalProperties": false, "required": ["kind", "capture_performed", "study_id", "design_sha256", "artifact"], "properties": {
        "kind": {"const": "cpu_profile"}, "capture_performed": {"const": true},
        "study_id": {"type": "string", "minLength": 1}, "design_sha256": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }}
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "source", "accepted_repeat_ids", "profile_claim"], "properties": {
        "id": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/artifact"},
        "accepted_repeat_ids": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"const": "pair-01"}, {"const": "pair-02"}, {"const": "pair-03"}, {"const": "pair-04"}], "items": false},
        "profile_claim": {"type": "boolean"}
      }}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "Nonempty regular file inside the package; no traversal, absolute path or symlink. Python performs full path checks."},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
