    "topic_specific_concept": true,
    "fixed_composition_required": false,
    "fixed_palette_required": false,
    "engagement_promise_allowed": false,
    "lead_with": "actual_chart_data_and_reader_decision",
    "illustration_role": "optional_supporting_mechanism"
  },
  "palette_policy": {
    "choose_for_topic": true,
    "consistent_state_meaning_within_related_assets": true,
