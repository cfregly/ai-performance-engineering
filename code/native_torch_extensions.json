      "patches": [
        {
          "id": "torch-2.13-plus-cxx20",
          "path": "setup.py",
          "reason": "PyTorch 2.13 and later require C++20 for extensions that include ATen headers; the pinned FlashAttention release explicitly selects C++17 for both host and CUDA compilation.",
          "upstream_issue": "https://github.com/Dao-AILab/flash-attention/issues/2863",
          "upstream_fix_commit": "https://github.com/Dao-AILab/flash-attention/commit/edb5c76ee329b18ed95d1f7ea9aa522a1331ab7d",
          "pytorch_release_matrix": "https://github.com/pytorch/pytorch/blob/main/RELEASE.md",
          "before_sha256": "152570de3092218ebbb0969281b6e0f58fea62ec65fd6029c7a20ea6589aacf4",
          "after_sha256": "367b9581e89423d0a00a3c8d28c3247600e0747aa7058bc00f05628edadc49b1",
          "replacements": [
            {
              "count": 1,
              "before": "    if FORCE_CXX11_ABI:\n        torch._C._GLIBCXX_USE_CXX11_ABI = True\n\n    nvcc_flags = [\n",
              "after": "    if FORCE_CXX11_ABI:\n        torch._C._GLIBCXX_USE_CXX11_ABI = True\n\n    # PyTorch 2.13+ requires C++20 for extensions that include ATen headers.\n    # The explicit -std flags below otherwise prevent PyTorch's build machinery\n    # from selecting the required standard.\n    cxx_standard = \"c++20\" if (TORCH_MAJOR, TORCH_MINOR) >= (2, 13) else \"c++17\"\n\n    nvcc_flags = [\n"
            },
            {
              "count": 1,
              "before": "    \"-std=c++17\",\n",
              "after": "    f\"-std={cxx_standard}\",\n"
            },
            {
              "count": 1,
              "before": "    compiler_c17_flag=[\"-O3\", \"-std=c++17\"]\n",
              "after": "    compiler_cxx_flag = [\"-O3\", f\"-std={cxx_standard}\"]\n"
            },
            {
              "count": 1,
              "before": "        compiler_c17_flag=[\"-O2\", \"/std:c++17\", \"/Zc:__cplusplus\"]\n",
              "after": "        compiler_cxx_flag = [\"-O2\", f\"/std:{cxx_standard}\", \"/Zc:__cplusplus\"]\n"
            },
            {
              "count": 1,
              "before": "                \"cxx\": compiler_c17_flag,\n",
              "after": "                \"cxx\": compiler_cxx_flag,\n"
            }
          ]
        }
