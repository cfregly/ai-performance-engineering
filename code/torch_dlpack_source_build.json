  "patches": [
    {
      "id": "torch2141-pure-wheel-metadata",
      "path": "pyproject.toml",
      "before_sha256": "03562c2a2e9b7782c8bd2ac83002dffa94696d703a1fac6864614be524709fa6",
      "after_sha256": "b6d9e3aef40f0fd4ede62e9cb9d4b77fd510ac39141c9f0591c1cdafd5b212b8",
      "reason": "Publish a distinct Torch 2.14-only local version, bind its runtime dependency to the public Torch 2.14.1 version, and keep the source-root PEP 517 backend out of the installed wheel.",
      "replacements": [
        {
          "count": 1,
          "before": "version = \"0.1.5\"",
          "after": "version = \"0.1.5+torch2141.nobackend1\""
        },
        {
          "count": 1,
          "before": "dependencies = [\"torch\"]",
          "after": "dependencies = [\"torch==2.14.1\"]"
        },
        {
          "count": 1,
          "before": "py-modules = [\"build_backend\"]",
          "after": "py-modules = []"
        }
      ]
    },
    {
      "id": "torch2141-no-legacy-fallback",
      "path": "torch_c_dlpack_ext/core.py",
      "before_sha256": "5804ca0f3aa3fd8feaac429f57bfb5711c7ad4d988f03c21d2eee73c11d970ff",
      "after_sha256": "1d65fe82da1f6254400a6d9897cbb066828113b641833500afb292777ca5c9d4",
      "reason": "The derived wheel carries no Torch 2.4 through 2.9 native fallbacks. Preserve the Torch 2.14 built-in path and raise a clear error when that API is absent.",
      "replacements": [
        {
          "count": 1,
          "before": "    if hasattr(torch.Tensor, \"__dlpack_c_exchange_api__\") or hasattr(\n        torch.Tensor, \"__c_dlpack_exchange_api__\"\n    ):\n        return None\n",
          "after": "    if hasattr(torch.Tensor, \"__dlpack_c_exchange_api__\"):\n        return None\n    raise RuntimeError(\n        \"torch-c-dlpack-ext 0.1.5+torch2141.nobackend1 requires \"\n        \"torch.Tensor.__dlpack_c_exchange_api__. Legacy native fallbacks \"\n        \"are intentionally absent.\"\n    )\n"
        }
      ]
    }
  ],
