          "Qwen/Qwen3-8B",
          "--host",
          "127.0.0.1",
          "--port",
          "8000",
          "--dtype",
          "bfloat16",
          "--tensor-parallel-size",
          "2",
          "--max-num-seqs",
          "3",
          "--max-model-len",
          "4096",
          "--gpu-memory-utilization",
          "0.75",
          "--enforce-eager"
        ],
        "environment": {
          "CUDA_VISIBLE_DEVICES": "0,1"
        },
        "working_directory": "../../../../",
        "ready_urls": [
          "http://127.0.0.1:8000/health"
