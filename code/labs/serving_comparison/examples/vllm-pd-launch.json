{
  "schema_version": "serving-comparison.process-group.v1",
  "processes": [
    {
      "name": "vllm-prefill",
      "command": [
        "vllm", "serve", "/models/Meta-Llama-3.1-8B-Instruct",
        "--served-model-name", "meta-llama/Meta-Llama-3.1-8B-Instruct",
        "--host", "127.0.0.1", "--port", "8101", "--dtype", "bfloat16",
        "--max-num-seqs", "32", "--max-num-queued-reqs", "32",
        "--kv-transfer-config", "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\",\"kv_buffer_device\":\"cuda\",\"kv_connector_extra_config\":{\"backends\":[\"UCX\"]}}"
      ],
      "environment": {"CUDA_VISIBLE_DEVICES": "0"}
    },
    {
      "name": "vllm-decode",
      "command": [
        "vllm", "serve", "/models/Meta-Llama-3.1-8B-Instruct",
        "--served-model-name", "meta-llama/Meta-Llama-3.1-8B-Instruct",
        "--host", "127.0.0.1", "--port", "8102", "--dtype", "bfloat16",
        "--max-num-seqs", "32", "--max-num-queued-reqs", "32",
        "--kv-transfer-config", "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\",\"kv_buffer_device\":\"cuda\",\"kv_connector_extra_config\":{\"backends\":[\"UCX\"]}}"
      ],
      "environment": {"CUDA_VISIBLE_DEVICES": "1"}
    },
    {
      "name": "vllm-pd-proxy",
      "command": [
        "python", "-m", "labs.serving_comparison.vllm_pd_proxy",
        "--host", "127.0.0.1", "--port", "8100",
        "--prefill-url", "http://127.0.0.1:8101",
        "--decode-url", "http://127.0.0.1:8102"
      ],
      "environment": {"CUDA_VISIBLE_DEVICES": ""}
    }
  ]
}
